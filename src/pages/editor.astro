---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <textarea id="code-editor">
-- Editor de código --

-- Comece digitando seu código Lua aqui... se você quiser.
-- Quem sabe, talvez o botão "Play" lá em cima faça algo interessante...

</textarea>
    <div id="game">
        <canvas id="canvas" width="256" height="256"></canvas>
    </div>

    <script>
        import { mainloop } from "../core.ts";
        import { canvasStartDrawing, canvasEndDrawing, canvasResize, canvasPushVertex } from "../canvas.ts";
        
        // main loop (core.ts)
        mainloop()
    </script>
</Layout>

<style>
    body {
        overflow: hidden; /* no scrolling */
        height: 100vh;
        background-color: black;
        display: grid;
        grid:
            "cd gm" 2fr
            "cd gm" 1fr / 1fr 1fr;
    }

    #settings label {
        display: block;
    }

    #settings select {
        background-color: transparent;
        color: white;
        text-align: center;
    }

    #code-editor {
        grid-area: cd;/* for body grid */
        padding: 50px;
        outline: none; /* when focused */
        resize: none;
        font-family: "Pixel Code";
        font-variant-ligatures: none; /* Pixel Code ligatures are annoying */
        background-color: black;
        color: white;
    }

    #game {
        grid-area: gm; /* for body grid */
        display: flex;
        justify-content: center; /* center canvas, canvas is automatically scaled to fit in canvas.ts */
        align-items: center;
    }

    #canvas {
        image-rendering: pixelated; /* canvas has fixed resolution and is scaled */
    }
</style>