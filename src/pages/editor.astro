---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <canvas id="canvas"></canvas>

    <script is:inline>
        var Module = {
            canvas: document.getElementById("canvas"),
        }
    </script>
    <script is:inline src="/wasm/main.js"></script>
</Layout>

<style>
    body {
        overflow: hidden; /* no scrolling */
        height: 100vh;
        background-color: black;
    }

    #canvas {
        width: 100%;
        height: 100%;
        image-rendering: pixelated; /* if canvas is scaled */
    }
</style>